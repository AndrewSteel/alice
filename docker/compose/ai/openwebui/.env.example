# ============================================================
# openwebui Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# PROJ-99: bearer token for the llama.cpp router (llama-3090, --api-key-file).
# Same value as OLLAMA_API_KEY in the other consumers' .env files.
OLLAMA_API_KEY=your-llama-api-key
