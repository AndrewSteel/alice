; llama.cpp router presets for llama-3090 (PROJ-99)
; -------------------------------------------------------------------
; Deploy the real file to the mounted volume as:
;   /srv/hot/models/llama-cpp/presets.ini
; It is NOT synced by scripts/sync-compose.sh (lives on a Docker volume).
;
; Section name = the model ID clients send in the OpenAI `model` field
;   (== $env.OLLAMA_MODEL / OLLAMA_MODEL_DMS / OLLAMA_VISION_MODEL).
;   NOTE: llama.cpp treats a ':' in the section name as a name:tag split and
;   rewrites it (e.g. [qwen3.5:27b-q4_K_M] was exposed as "qwen3.5:Q4_K_M").
;   So the IDs must be colon-free — hence the plain names below.
;
;   qwen3-vl-30b           -> Qwen3-VL-30B-A3B-Instruct  (MoE, weights + mmproj)
;   mistral-small-3.2-24b  -> Mistral-Small-3.2-24B-Instruct-2506  (dense, text)
;
; PATHS: must be ABSOLUTE. The router spawns each sub-server with a working
;   directory that is NOT /models, so relative filenames fail with
;   "failed to open GGUF file ... (No such file or directory)". The volume is
;   mounted at /models, so use /models/<file>.gguf.

[*]
; Global defaults applied to every model below.
;
; ctx-size 16384: working minimum for the agent tool loop — Alice sends the
; last 20 turns + system prompt + 7-tool schema + up to 4 rounds of tool-result
; JSON (search hits can be large). 8192 overflows as soon as a search returns
; many results. If qwen ever OOMs next to Weaviate, step down 16384 -> 12288.
ctx-size    = 16384
n-gpu-layers = 999
flash-attn  = on
; NO stop-timeout / idle-unload: a model stays resident until a request for the
; other model evicts it (router --models-max 1). This mirrors the old Ollama
; OLLAMA_KEEP_ALIVE=-1 so qwen does not drop out during the working day.

[qwen3-vl-30b]
model      = /models/Qwen3VL-30B-A3B-Instruct-Q4_K_M.gguf
mmproj     = /models/mmproj-Qwen3VL-30B-A3B-Instruct-F16.gguf
; Warm qwen right after a container (re)start so the first chat is instant.
load-on-startup = true
; Qwen3-VL needs >=1024 image tokens for reliable grounding; without this it
; down-samples the (already <=1024 px) DMS images too far and the descriptions
; get vague. See https://github.com/ggml-org/llama.cpp/issues/16842
image-min-tokens = 1024
; parallel = 1: one KV-cache slot instead of the default 4. Alice runs one
; sequential chat stream per user; 4 slots x 16k ctx would cost ~3-4 GB extra
; and OOM next to Weaviate on the shared 3090. Concurrent chats serialise
; (fine for 1-2 users).
parallel = 1
; Qwen thinking models emit reasoning in a <think> block; expose it as the
; OpenAI `reasoning_content` field (consumed by alice-chat-stream, PROJ-37).
reasoning-format = deepseek

[mistral-small-3.2-24b]
; bartowski re-quant (no HF login). Official gated repo file name may differ.
model = /models/mistralai_Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf
; ~5 GB smaller than qwen and only used for short DMS extraction prompts, so
; the global 16384 is plenty — no per-model override needed.
