; llama.cpp router presets for llama-3090 (PROJ-99)
; -------------------------------------------------------------------
; Deploy the real file to the mounted volume as:
;   /srv/hot/models/llama-cpp/presets.ini
; It is NOT synced by scripts/sync-compose.sh (lives on a Docker volume).
;
; Section name = the model ID clients send in the OpenAI `model` field.
;   Kept EXACTLY equal to the retired Ollama tag names so no consumer
;   prompt/config changes. The tags are local names; the real models are:
;     qwen3.5:27b-q4_K_M    -> Qwen3-VL-30B-A3B-Instruct  (MoE, weights + mmproj)
;     mistral-small3.2:24b  -> Mistral-Small-3.2-24B-Instruct-2506  (dense, text only)
;
; - relative paths are resolved against the preset file dir.
; - GGUF filenames below match the official Qwen repo and bartowski's Mistral
;   re-quant. See README.md ("Getting the GGUF files") for the download commands
;   and the `hf:` auto-download alternative.

[*]
; Global defaults applied to every model below.
; ctx-size 8192: the RTX 3090's 24 GB is SHARED with the two Weaviate inference
; containers (t2v-transformers ~3.3 GB + multi2vec-clip ~1.4 GB = ~4.7 GB
; always resident). Under Ollama, qwen + Weaviate already sat at ~23.7 / 24 GB
; with only ~0.9 GB free. Qwen3-VL-30B-A3B-Q4 (~18.6 GB) + F16 mmproj (~1.1 GB)
; leaves almost no room for the KV cache, so keep the context small. Raise this
; per-model only after `nvidia-smi` at cutover shows headroom.
ctx-size    = 8192
n-gpu-layers = 999
flash-attn  = on
; NO stop-timeout / idle-unload: a model stays resident until a request for the
; other model evicts it (router --models-max 1). This mirrors the old Ollama
; OLLAMA_KEEP_ALIVE=-1 so qwen does not drop out during the working day.

[qwen3.5:27b-q4_K_M]
model      = Qwen3VL-30B-A3B-Instruct-Q4_K_M.gguf
mmproj     = mmproj-Qwen3VL-30B-A3B-Instruct-F16.gguf
; Warm qwen right after a container (re)start so the first chat is instant.
load-on-startup = true
; Qwen thinking models emit reasoning in a <think> block; expose it as the
; OpenAI `reasoning_content` field (consumed by alice-chat-stream, PROJ-37).
reasoning-format = deepseek

[mistral-small3.2:24b]
; bartowski re-quant (no HF login). Official gated repo:
;   model = mistralai_Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf  (from mistralai/...-GGUF)
model = mistralai_Mistral-Small-3.2-24B-Instruct-2506-Q4_K_M.gguf
; ~5 GB smaller than qwen and only used for short extraction prompts, so it can
; take a bigger window if a workflow ever needs it — uncomment and raise:
; ctx-size = 16384
