; llama.cpp router presets for llama-3090 (PROJ-99)
; -------------------------------------------------------------------
; Deploy the real file to the mounted volume as:
;   /srv/hot/models/llama-cpp/presets.ini
; It is NOT synced by scripts/sync-compose.sh (lives on a Docker volume).
;
; Section name  = the model ID clients send in the OpenAI `model` field.
;                 Keep these EXACTLY equal to the retired Ollama model names
;                 so no consumer prompt/config has to change:
;                   qwen3.5:27b-q4_K_M      → chat + vision  (weights + mmproj)
;                   mistral-small3.2:24b    → DMS text extraction  (weights only)
; - relative paths are resolved against the preset file dir.
; - GGUF filenames below are PLACEHOLDERS — replace with the real ones after
;   `huggingface-cli download` (see README.md → "Getting the GGUF files").
;   Or reference Hugging Face directly (auto-download into cache/ on first use):
;       model  = hf:<HF_REPO_QWEN>:<Q4_K_M_TAG>
;       mmproj = hf:<HF_REPO_QWEN>:<MMPROJ_TAG>
;   (needs container internet + HF_TOKEN for gated repos — README has trade-offs)

[*]
; Global defaults applied to every model below.
ctx-size    = 16384
n-gpu-layers = 999
flash-attn  = on
; NO stop-timeout / idle-unload: a model stays resident until a request for the
; other model evicts it (router --models-max 1). This mirrors the old Ollama
; OLLAMA_KEEP_ALIVE=-1 so qwen does not drop out during the working day.

[qwen3.5:27b-q4_K_M]
model      = REPLACE-qwen-instruct-q4_k_m.gguf
mmproj     = REPLACE-qwen-mmproj-f16.gguf
; Warm qwen right after a container (re)start so the first chat is instant.
load-on-startup = true
; Qwen thinking models emit reasoning in a <think> block; expose it as the
; OpenAI `reasoning_content` field (consumed by alice-chat-stream, PROJ-37).
reasoning-format = deepseek

[mistral-small3.2:24b]
model = REPLACE-mistral-small-instruct-q4_k_m.gguf
