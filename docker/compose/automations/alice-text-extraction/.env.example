# alice-text-extraction (PROJ-117) — copy to .env and fill in.
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# Optional (defaults shown)
# EXTRACT_CONCURRENCY=2                  # max. sources extracted at the same time
# EXTRACT_POLL_SECONDS=10                # wait time when there is no work
# EXTRACT_HEARTBEAT_SECONDS=60           # sign of life to the register while a source is in work
# EXTRACT_OCR_PAGE_TIMEOUT_SECONDS=120   # time limit of the OCR of one PDF page
# EXTRACT_FILE_TIMEOUT_SECONDS=600       # time limit of one LibreOffice conversion
# EXTRACT_MAX_FILE_MB=200                # larger originals fail permanently
# EXTRACT_LANGUAGE_MIN_CHARS=100         # fewer letters -> language stays empty
# EXTRACT_TEXT_MIN_CHARS=10              # usable PDF text layer: min. letters/digits per page
# EXTRACT_TEXT_MIN_QUALITY=0.6           # usable PDF text layer: min. share of readable characters
# EXTRACT_OCR_LANGUAGES=deu+eng
# EXTRACT_OCR_DPI=300
# EXTRACT_NAS_ROOT=/mnt/nas              # share = first path element below this root
# EXTRACT_MISSING_RETRY_SECONDS=3600     # original missing (share reachable): hand out again after this time
# EXTRACT_NAS_RETRY_SECONDS=60           # share missing: pause new work for this time
# EXTRACT_REGISTRY_GRACE_SECONDS=60      # register unreachable longer than this -> unhealthy
# EXTRACT_BATCH=false                    # true: batch commits of the register (mass run, PROJ-120)
