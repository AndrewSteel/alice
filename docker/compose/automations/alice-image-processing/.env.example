# alice-image-processing (PROJ-125) — copy to .env and fill in.
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# Own state (backlog boundary, Geoapify calls per day, triggered images; section 22 of init-schema.sql)
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# LLM gateway (PROJ-111) with an own key of tier "background" (entry `image-processing` in
# /srv/warm/llm-gateway/clients). Never the inference server directly.
LLM_GATEWAY_URL=http://alice-llm-gateway:8011
LLM_GATEWAY_KEY=your-gateway-key
# Vision model as configured in the gateway / llama-3090 router
IMAGE_VISION_MODEL=your-vision-model
# Old Weaviate (collection `Image`, only read for the place takeover)
WEAVIATE_URL=http://weaviate:8080
# Reverse geocoding (shares the quota with the old alice-dms-processor: keep the sum of both
# daily limits within the plan)
GEOAPIFY_API_KEY=your-geoapify-key
# Optional (defaults shown)
# GEOAPIFY_URL=https://api.geoapify.com
# IMAGE_BACKLOG_RELEASED=false          # true: describe the backlog too (after the sample, AK-41)
# IMAGE_LOCATION_TAKEOVER=true          # false: never ask the old Weaviate, Geoapify directly (PROJ-142)
# IMAGE_GEOAPIFY_DAILY_LIMIT=3000       # Geoapify calls per day (Europe/Berlin)
# IMAGE_GEOAPIFY_RATE=5                 # max. Geoapify calls per second
# IMAGE_DESCRIBE_CONCURRENCY=1          # max. images described at the same time
# IMAGE_MAX_SIDE_PX=1024                # longest side of each (tile) image sent to the vision model
# IMAGE_MAX_MEGAPIXELS=250              # larger images fail permanently
# IMAGE_LLM_TIMEOUT_SECONDS=900         # per vision call, including the wait in the gateway queue
# IMAGE_LLM_RETRY_SECONDS=60            # gateway unavailable: pause new descriptions for this time
# IMAGE_MAX_TOKENS=4096                 # max. answer length per vision call
# IMAGE_WEAVIATE_RETRY_SECONDS=300      # old Weaviate unavailable: places wait this long
# IMAGE_GEOAPIFY_TIMEOUT_SECONDS=15
# IMAGE_WEAVIATE_TIMEOUT_SECONDS=15
# IMAGE_POLL_SECONDS=10                 # wait time when there is no work
# IMAGE_HEARTBEAT_SECONDS=60            # sign of life to the register while an image is in work
# IMAGE_NAS_ROOT=/mnt/nas
# IMAGE_MISSING_RETRY_SECONDS=3600      # original missing (share reachable): hand out again after
# IMAGE_NAS_RETRY_SECONDS=60            # share missing: pause new work for this time
# IMAGE_REGISTRY_GRACE_SECONDS=60       # register / database unreachable longer than this -> unhealthy
# IMAGE_TIMEZONE=Europe/Berlin          # day of the Geoapify limit, title time from `modified`
# IMAGE_BATCH=false                     # true: batch commits of the register (mass run)
