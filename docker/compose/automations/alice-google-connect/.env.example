# ============================================================
# alice-google-connect Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

POSTGRES_CONNECTION=postgresql://user:password@postgres:5432/alice

# --- JWT (RS256, verification only) ---
# Public key is mounted read-only from /srv/warm/alice/keys/ (see compose.yml).
# This service never signs tokens, so no private key is needed.
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# --- Google OAuth client ---
# From the Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). The consent screen must be "In Production", otherwise
# refresh tokens expire after 7 days.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Must match the redirect URI registered on the OAuth client exactly.
GOOGLE_REDIRECT_URI=https://alice.happy-mining.de/api/google/callback

# Where the browser is sent after the callback finished (success or error).
# Result is appended as query params: ?google=connected&account=... or
# ?google=error&reason=...
FRONTEND_REDIRECT_URL=https://alice.happy-mining.de/settings

# --- Token encryption ---
# AES-256-CBC passphrase for the stored Google access/refresh tokens.
# The key is derived as SHA-256(GOOGLE_ENC_KEY). Deliberately separate from
# MAIL_ENC_KEY (separation of security domains).
# Generate a strong value: openssl rand -base64 32
GOOGLE_ENC_KEY=change-me-to-a-strong-random-passphrase
