# alice-etl-rebuild (PROJ-120) — copy to .env and fill in.
# PostgreSQL with the schema alice (rebuild runs, reconciliation results; reads register and document tables)
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# Internal interfaces of the source register (PROJ-115) and the file detection (PROJ-116)
REGISTRY_URL=http://alice-source-registry:8012
DETECTION_URL=http://alice-file-detection:8013
# PROJ-123: mail import for the levels 5 (IMAP <-> register) and 6 (register <-> mail archive); empty = off
MAIL_IMPORT_URL=http://alice-mail-import:8019
# Optional (defaults shown)
# REBUILD_STAGE_LIMIT=50                  # max. sources of a rebuild run pending/running per stage
# REBUILD_STAGE_LIMITS=                   # per stage, e.g. classify=10,extract=20
# REBUILD_LOG_INTERVAL_SECONDS=900        # progress line in the log while a run is active
# RECONCILE_NIGHTLY_TIME=03:00            # nightly reconciliation (after the nightly run of the detection)
# RECONCILE_TIMEZONE=Europe/Berlin
# RECONCILE_CATCHUP_HOURS=6               # missed nightly reconciliation is caught up within this time
# RECONCILE_PENDING_LIMIT_HOURS=24        # level 3: stage pending longer than this is reported
# RECONCILE_REPAIR_LIMIT_PERCENT=5        # more planned repairs than this share of the sources: repair nothing
# RECONCILE_HASH_CYCLE_DAYS=30            # every original is re-hashed once within this cycle
# RECONCILE_HASH_PORTION_SECONDS=3600     # max. re-hash time per night
# RECONCILE_HASH_PORTION_BYTES=           # data per night; empty = inventory / cycle days
# RECONCILE_RETENTION_DAYS=90             # reconciliation results are kept this long (min. 30)
