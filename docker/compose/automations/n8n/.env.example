# ============================================================
# Alice - n8n Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# N8N_BASIC_AUTH_USER and N8N_BASIC_AUTH_PASSWORD
USER=your_username
PASSWORD=your_password

HA_URL=http://homeassistant:8123
HA_TOKEN=your-long-lived-access-token

# PROJ-99: llama.cpp router (OpenAI-compatible), base URL WITHOUT /v1.
# Used by the DMS workflows' Code nodes (previously a hardcoded ollama-3090 URL).
OLLAMA_URL=http://llama-3090:11434
# Bearer token for the llama.cpp router. Empty = no auth header.
OLLAMA_API_KEY=your-llama-api-key
WEAVIATE_URL=http://weaviate:8080
POSTGRES_CONNECTION=postgresql://user:password@postgres:5432/alice

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=your-redis-password

MQTT_URL=mqtt://mosquitto:1883

# Minimum Weaviate cosine similarity score to accept an intent match (0.0-1.0)
INTENT_MIN_CERTAINTY=0.93

# How many candidate intents to retrieve per nearText query
INTENT_MAX_RESULTS=3

# Model ID used by the legacy chat handler (llama.cpp preset section name)
OLLAMA_MODEL=qwen3.5:27b-q4_K_M

# Model ID used by the DMS workflows (llama.cpp preset section name)
OLLAMA_MODEL_DMS=mistral-small3.2:24b

# Vision model ID used by alice-dms-image-description-backfill (same as dms-extractor-image)
OLLAMA_VISION_MODEL=qwen3.5:27b-q4_K_M

# Geoapify reverse geocoding (PROJ-56 nightly geocode phase in alice-dms-processor)
GEOAPIFY_API_KEY=your-geoapify-api-key

# Daily request quota for the Geoapify free tier
GEOAPIFY_DAILY_LIMIT=3000
