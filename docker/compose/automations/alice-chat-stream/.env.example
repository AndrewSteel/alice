# ============================================================
# alice-chat-stream Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- JWT (RS256, public key from file) ---
# The private key stays in alice-auth. Only the public key is mounted here.
# See compose.yml: /srv/warm/alice/keys/jwt_public.pem:/run/secrets/jwt_public.pem:ro
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# --- PostgreSQL ---
# asyncpg DSN — note "postgresql://", NOT "postgres://"
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice

# --- Inference backend (PROJ-99: llama.cpp router, OpenAI-compatible) ---
# Base URL WITHOUT the /v1 suffix — the client appends /v1/chat/completions.
OLLAMA_URL=http://llama-3090:11434
# Model ID = llama.cpp preset section name (must be colon-free — llama.cpp
# rewrites a ':' in the section name).
OLLAMA_MODEL=qwen3-vl-30b
# Bearer token for the llama.cpp router (--api-key-file). Empty = no auth header.
OLLAMA_API_KEY=your-llama-api-key
# Raised for PROJ-99: a cold model load on the shared 3090 can take up to ~60s
# before the first token; must stay above that.
OLLAMA_TIMEOUT_SECONDS=120
# PROJ-37: stream reasoning tokens. llama.cpp exposes them as
# choices[].delta.reasoning_content. Set to "false" to disable.
OLLAMA_THINK=true

# --- Weaviate ---
WEAVIATE_URL=http://weaviate:8080

# --- Redis (PROJ-80: DMS coverage dashboard path-scan baseline) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# --- Home Assistant (HA Fast-Path runs in Python directly) ---
HA_URL=http://homeassistant:8123
HA_TOKEN=your-ha-long-lived-token
INTENT_MIN_CERTAINTY=0.82
INTENT_MAX_RESULTS=5

# --- n8n Sub-Workflow Webhooks ---
# alice-tool-search must have a Webhook trigger at /webhook/alice-tool-search
N8N_TOOL_SEARCH_URL=http://n8n:5678/webhook/alice-tool-search
# alice-tool-ha is optional — leave empty to disable the home_assistant LLM tool
N8N_TOOL_HA_URL=
# alice-mail-tools is optional — leave empty to disable mail query tools (PROJ-46)
N8N_TOOL_MAIL_URL=http://n8n:5678/webhook/alice-mail-tools
# Raised from 15s (PROJ-73): alice-tool-search/alice-mail-tools' internal
# Weaviate timeout was raised to 30s for uncapped recency queries, so this
# client-side timeout must stay comfortably above that.
TOOL_TIMEOUT_SECONDS=40

# --- n8n Admin Monitoring (PROJ-77) ---
# Server-only n8n API key for the admin dashboard's execution-monitoring
# tiles (running/failed workflows). Never sent to the browser. Create under
# n8n → Settings → API.
N8N_API_URL=http://n8n:5678
N8N_API_KEY=your-n8n-api-key
# Public URL used to build "open in n8n" links for the browser.
N8N_PUBLIC_URL=https://n8n.happy-mining.de

# --- Timer-Agent (PROJ-85) ---
# The timer expiry watcher runs as a background asyncio task in this service.
# Voice-PE melody delivery goes through Home Assistant (HA_URL/HA_TOKEN above)
# plus the companion automation in homeassistant/alice_timer_melody.yaml.
#
# Bundle window: timers of the same device coming due within this many seconds
# share one melody + one announcement.
TIMER_COLLECT_WINDOW_SECONDS=3
# Self-stop for an un-acknowledged Voice-PE melody.
TIMER_MELODY_MAX_SECONDS=120
# HA script entities Alice signals to start / stop the melody.
TIMER_MELODY_START_SCRIPT=script.alice_timer_melody_start
TIMER_MELODY_STOP_SCRIPT=script.alice_timer_melody_stop
# Optional explicit device -> media_player map. Comma-separated
# "esphome:<Raum>=media_player.<entity>" pairs. When unset, the watcher uses
# the first media_player entity found in the device's room in alice.ha_entities.
TIMER_MEDIA_PLAYER_MAP=

# --- Logging ---
LOG_LEVEL=INFO
