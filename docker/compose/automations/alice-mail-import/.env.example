# alice-mail-import (PROJ-123) — copy to .env and fill in.
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# Same value as MAIL_ENC_KEY of alice-mail-reader: decrypts the stored IMAP passwords
# (no second password store). Never log or share it.
MAIL_ENC_KEY=change-me-to-the-key-of-alice-mail-reader
# LLM gateway (PROJ-111) with an own key of tier "background" (entry `mail-import` in
# /srv/warm/llm-gateway/clients). Never the inference server directly.
LLM_GATEWAY_URL=http://alice-llm-gateway:8011
LLM_GATEWAY_KEY=your-gateway-key
CLASSIFY_MODEL=your-model-name
# Mail archive on the NAS (must exist; never created by the service)
MAIL_ARCHIVE_PATH=/mnt/nas/ai/mail
# Optional (defaults shown)
# MAIL_SENT_FOLDER_FALLBACK=Sent        # sent folder when the server does not flag one (\Sent)
# MAIL_BATCH_SIZE=200                   # mails per tick and mailbox (history packages)
# MAIL_BATCH_THRESHOLD=20               # more new mails than this in one tick → batch commits
# MAIL_HISTORY_PAUSE_SECONDS=5          # history left: mailbox due again after this pause
# MAIL_DELETE_LIMIT_PERCENT=20          # nightly: max. share of known locations removed per mailbox
# MAIL_NIGHTLY_TIME=02:30               # nightly reconciliation with the mail servers
# MAIL_NIGHTLY_CATCHUP_HOURS=6          # missed nightly run is caught up within this time
# MAIL_TIMEZONE=Europe/Berlin
# MAIL_TICK_SECONDS=5                   # how often due mailboxes are looked for
# MAIL_MAX_PARALLEL_MAILBOXES=4
# MAIL_IMAP_TIMEOUT_SECONDS=120
# MAIL_CLASSIFY_CHARS=4000              # characters of the mail text sent to the LLM
# MAIL_CLASSIFY_MAX_TOKENS=1024
# MAIL_LLM_TIMEOUT_SECONDS=900          # per LLM call, including the wait in the gateway queue
# MAIL_LLM_RETRY_SECONDS=60             # gateway unavailable: pause classify for this time
# MAIL_EXTRACT_DISABLED=false
# MAIL_CLASSIFY_DISABLED=false
