# alice-lists (PROJ-106) — copy to .env and fill in.
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
# Redis for the short-lived delete tickets and open follow-up questions.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional
# DELETE_TICKET_TTL_SECONDS=300
