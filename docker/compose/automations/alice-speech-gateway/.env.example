# ============================================================
# alice-speech-gateway Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- JWT (RS256, public key from file) ---
# Same public key as alice-auth / alice-chat-stream. Only the public key is
# mounted here; the private key never leaves alice-auth.
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# --- STT (faster-whisper) ---
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Cached model files (HF download dir). Mounted from the host.
WHISPER_MODEL_DIR=/data
# Default transcription language (ISO 639-1).
SPEECH_LANGUAGE=de

# --- AI backend (alice-chat-stream SSE endpoint) ---
CHAT_STREAM_URL=http://alice-chat-stream:8003
# AI response timeout in seconds — speech error if exceeded.
AI_TIMEOUT_SECONDS=15

# --- TTS (wyoming-piper) ---
PIPER_URI=tcp://wyoming-piper:10200

# --- Wyoming server (HA Voice Devices) ---
WYOMING_PORT=10300
# The Wyoming path has no client JWT, but alice-chat-stream requires one.
# The gateway mints a short-lived service token signed with the SAME RSA key
# pair as alice-auth. This needs the PRIVATE key, mounted read-only.
# Leave SERVICE_JWT_PRIVATE_KEY_PATH empty to DISABLE the Wyoming endpoint
# (WebApp WS endpoints still work with client JWTs).
SERVICE_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
SERVICE_JWT_TTL_SECONDS=120

# --- Conversation behaviour ---
# Continued-conversation silence timeout in seconds.
SILENCE_TIMEOUT_SECONDS=30
# Minimum audio length accepted for STT; shorter clips are rejected.
MIN_AUDIO_SECONDS=0.5

# --- Device -> User mapping (Wyoming / HA Voice Devices) ---
# YAML file mounted from a Docker volume. Maps HA device IDs to alice user_ids.
DEVICE_MAPPING_PATH=/config/device-mapping.yaml

# --- Barge-in intent phrases ---
# YAML file with the configurable German interrupt-phrase list.
INTERRUPT_PHRASES_PATH=/config/interrupt-phrases.yaml

# --- Speaker Recognition (PROJ-43) ---
# asyncpg DSN — leave empty to disable speaker recognition entirely.
# Note: also requires the 'backend' Docker network (see compose.yml).
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# SpeechBrain ECAPA-TDNN model cache dir (auto-downloaded on first run, ~85 MB).
SPEAKER_MODEL_PATH=/data/speaker-model
# Cosine similarity threshold (0.0–1.0). Scores below this → Guest role.
SPEAKER_THRESHOLD=0.75
# CUDA device for Speaker-ID model; set to "cpu" if GPU is at capacity.
SPEAKER_DEVICE=cuda

# --- Logging ---
LOG_LEVEL=INFO
