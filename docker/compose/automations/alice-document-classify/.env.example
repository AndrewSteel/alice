# alice-document-classify (PROJ-118) — copy to .env and fill in.
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# LLM gateway (PROJ-111) with an own key of tier "background" (entry `document-classify` in
# /srv/warm/llm-gateway/clients). Never the inference server directly.
LLM_GATEWAY_URL=http://alice-llm-gateway:8011
LLM_GATEWAY_KEY=your-gateway-key
# Model as for the old DMS processing
CLASSIFY_MODEL=your-model-name
# Optional (defaults shown)
# CLASSIFY_CONCURRENCY=1                 # max. sources classified at the same time
# CLASSIFY_POLL_SECONDS=10               # wait time when there is no work
# CLASSIFY_HEARTBEAT_SECONDS=60          # sign of life to the register while a source is in work
# CLASSIFY_LLM_TIMEOUT_SECONDS=900       # per LLM call, including the wait in the gateway queue
# CLASSIFY_LLM_RETRY_SECONDS=60          # gateway unavailable: pause new work for this time
# CLASSIFY_MAX_TOKENS=8192               # max. answer length per LLM call
# CLASSIFY_THINK=false                   # true: let hybrid-thinking models think (slow, blocks chat)
# CLASSIFY_CONFIDENCE_THRESHOLD=0.7      # below: second try with higher temperature, then uncertain
# CLASSIFY_RETRY_TEMPERATURE=0.7         # temperature of that second try
# CLASSIFY_HEAD_CHARS=20000              # characters from the start for type, title, summary, fields
# CLASSIFY_CHUNK_CHARS=8000              # section size for the bookings of bank statements
# CLASSIFY_LANGUAGE_THRESHOLD=0.15       # share of English function words that counts as "not German"
# CLASSIFY_TIMEZONE=Europe/Berlin        # time zone of the title prefix
# CLASSIFY_REGISTRY_GRACE_SECONDS=60     # register unreachable longer than this -> unhealthy
# CLASSIFY_BATCH=false                   # true: batch commits of the register (mass run, PROJ-120)
