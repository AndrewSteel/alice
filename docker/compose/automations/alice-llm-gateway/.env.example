# alice-llm-gateway (PROJ-111) — copy to .env. All settings are optional.
# Secrets are NOT set here but mounted as files (see compose.yml):
#   /srv/warm/llm-gateway/clients         -> caller keys + tiers (clients.example)
#   /srv/warm/llama-3090/llama_api_key    -> the real llama-3090 key
UPSTREAM_URL=http://llama-3090:11434
# Max. silence from llama-3090 while a request holds the slot (hung upstream).
# Queue wait itself is never limited — the callers' own timeouts apply.
# UPSTREAM_READ_TIMEOUT_SECONDS=900
# UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
# MAX_BODY_BYTES=52428800
