# ============================================================
# alice-auth Environment Variables (Example)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

POSTGRES_CONNECTION=postgresql://user:password@postgres:5432/alice

# --- JWT (RS256) ---
# RSA key pair lives on the host at /srv/warm/alice/keys/ and is mounted
# read-only into the container (see compose.yml). Generate the keys once with:
#   openssl genrsa -out /srv/warm/alice/keys/jwt_private.pem 4096
#   openssl rsa -in /srv/warm/alice/keys/jwt_private.pem -pubout \
#               -out /srv/warm/alice/keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
