# alice-etl-status (PROJ-122) — copy to .env and fill in.
# PostgreSQL with the schema alice (reads users, register and stage tables; writes nothing)
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# RS256 public key of alice-auth (mounted by compose.yml)
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
# Internal interfaces of the source register (PROJ-115) and of rebuild/reconciliation (PROJ-120)
REGISTRY_URL=http://alice-source-registry:8012
REBUILD_URL=http://alice-etl-rebuild:8017
# Optional (default shown)
# ETL_RETRY_LIMIT=1000                    # max. sources of a bulk "retry"; larger selections: use a rebuild
