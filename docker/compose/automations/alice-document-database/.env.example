# alice-document-database (PROJ-119) — copy to .env and fill in.
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# PostgreSQL with the schema alice (tables alice.doc_*)
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# Optional (defaults shown)
# DATABASE_CONCURRENCY=2                 # max. documents written at the same time
# DATABASE_POLL_SECONDS=10               # wait time when there is no work (DB is current within this time)
# DATABASE_HEARTBEAT_SECONDS=60          # sign of life to the register while a document is in work
# DATABASE_DB_RETRY_SECONDS=30           # PostgreSQL unreachable: pause new work for this time
# DATABASE_REGISTRY_GRACE_SECONDS=60     # register unreachable longer than this -> unhealthy
