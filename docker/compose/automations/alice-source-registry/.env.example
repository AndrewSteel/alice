# alice-source-registry (PROJ-115) — copy to .env and fill in.
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# Redis is only the work queue (rebuilt from the register when emptied).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Host folder of the source of truth on the writable NAS share (used by compose.yml).
# Must exist (empty on first start); the service never creates it.
SOT_NAS_DIR=/mnt/nas/ai/source-of-truth
# Source-of-truth repo inside the container (bind-mounted NAS folder, see compose.yml).
SOT_REPO_PATH=/data/sot
# Optional (defaults shown)
# SOT_STALE_RUNNING_SECONDS=1800   # running longer than this -> back to pending
# SOT_SCAN_INTERVAL_SECONDS=60     # check interval for hand corrections
# SOT_GIT_LOCK_STALE_SECONDS=120   # orphaned git lock files older than this are removed
# SOT_BATCH_MAX_FILES=500          # batch commit: max files
# SOT_BATCH_MAX_SECONDS=300        # batch commit: max age
# SOT_TIMEZONE=Europe/Berlin       # time zone of the <YYYY>/<MM> folders
