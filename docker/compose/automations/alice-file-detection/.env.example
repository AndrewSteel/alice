# alice-file-detection (PROJ-116) — copy to .env and fill in.
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
# Internal interface of the source register (PROJ-115).
REGISTRY_URL=http://alice-source-registry:8012
# Optional (defaults shown)
# DETECT_SCAN_INTERVAL_SECONDS=300     # day scan interval
# DETECT_NIGHTLY_TIME=02:00            # nightly run (local time, HH:MM)
# DETECT_TIMEZONE=Europe/Berlin
# DETECT_CATCHUP_HOURS=6               # an interrupted nightly run is repeated within this time
# DETECT_DELETE_LIMIT_PERCENT=20       # max. share of known locations removed per NAS share and night
# DETECT_NAS_ROOT=/mnt/nas             # share = first path element below this root
# DETECT_EXT_DOCUMENT=pdf,txt,md,docx,doc,xlsx,xls,odt,ods
# DETECT_EXT_IMAGE=jpg,jpeg,png,webp,heic,tif,tiff
# DETECT_EXT_AUDIO=mp3,m4a,wav,flac,ogg,aac
# DETECT_EXT_VIDEO=mp4,mov,mkv,avi,m4v,webm
# DETECT_SKIP_DIRS=@eaDir,#recycle     # hidden files/folders, links and empty files are always skipped
# DETECT_SKIP_FILES=~$*,*.tmp,*.part,*.crdownload,Thumbs.db,desktop.ini
# DETECT_EXCLUDE_PATHS=                # comma-separated paths that are never scanned
# DETECT_SUMMARY_RETENTION_DAYS=90     # stored run summaries (at least 30 days)
