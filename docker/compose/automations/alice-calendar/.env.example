# alice-calendar (PROJ-87) — copy to .env and fill in.
POSTGRES_DSN=postgresql://user:password@postgres:5432/alice
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
# PROJ-86 service; the user's JWT is forwarded for token retrieval.
GOOGLE_CONNECT_URL=http://alice-google-connect:8008
# Redis for the short-lived delete confirmation tickets.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional
# DELETE_TICKET_TTL_SECONDS=300
# GOOGLE_HTTP_TIMEOUT=10
