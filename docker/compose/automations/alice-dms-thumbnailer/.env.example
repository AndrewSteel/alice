# Path to JWT RS256 public key on the host — same path is used inside the container
JWT_PUBLIC_KEY_PATH=/srv/warm/alice/keys/jwt_public.pem

# Root of the NAS mount — all document paths in Weaviate start here.
# Must match the host path mounted via nas-volumes.yml (extends).
# Path validator in main.py rejects any original_path not under this root.
DOCUMENTS_ROOT=/mnt/nas

# Directory where thumbnails are written (must be writable inside container)
THUMB_DIR=/srv/warm/documents/thumbnails

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
