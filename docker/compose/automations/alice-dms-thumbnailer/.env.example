# Path to JWT RS256 public key on the host — same path is used inside the container
JWT_PUBLIC_KEY_PATH=/srv/warm/alice/keys/jwt_public.pem

# Root directory where DMS source documents are stored (mounted read-only)
DOCUMENTS_ROOT=/srv/warm/documents

# Directory where thumbnails are written (subdir of DOCUMENTS_ROOT, writable)
THUMB_DIR=/srv/warm/documents/thumbnails

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
