# MQTT Broker (Input)
MQTT_HOST=your-mqtt-host
MQTT_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Redis (Output)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Inference backend (PROJ-99: llama.cpp router, OpenAI-compatible)
# Base URL WITHOUT /v1 — the code appends /v1/chat/completions.
# PROJ-111: via the priority gateway, never llama-3090 directly.
OLLAMA_URL=http://alice-llm-gateway:8011
OLLAMA_VISION_MODEL=qwen3-vl-30b
# Bearer token for the llama.cpp router. Empty = no auth header.
# PROJ-111: this caller's OWN gateway key (dms-extractor-image (background) in /srv/warm/llm-gateway/clients),
# NOT the llama-3090 key.
OLLAMA_API_KEY=your-gateway-key
